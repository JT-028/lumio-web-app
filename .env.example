# Names only. Values stay empty in git. Paste them in Vercel. Never commit .env.
# NEXT_PUBLIC_* is build-time. The two server keys are runtime only.

# Supabase project URL. Build-time. Required before sign-in works.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred browser key. Build-time. One of the two browser keys is required.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older browser key. Build-time. Used only when the publishable key is unset.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase secret. Runtime. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Older server-only service role. Runtime. Used only when the secret key is unset.
SUPABASE_SERVICE_ROLE_KEY=
# Public site origin. Build-time. Used for links.
NEXT_PUBLIC_APP_URL=
# Server-only Resend key. Runtime. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# Server-only verified sender. Runtime. Never prefix with NEXT_PUBLIC_.
RESEND_FROM_EMAIL=
